#!/bin/sh
# Stormlight pre-commit: run the UI gate when files under ui/ (or Navigation.kt) change.
# Enable once per clone:  git config core.hooksPath .githooks   (works in Git Bash on Windows too)
changed=$(git diff --cached --name-only | grep -E 'zeusreader/(ui/|Navigation\.kt)' || true)
[ -z "$changed" ] && exit 0
cd android || exit 1
if [ -f gradlew.bat ] && [ "$OS" = "Windows_NT" ]; then
  ./gradlew.bat uiCheck --console=plain || { echo "uiCheck failed — commit blocked."; exit 1; }
else
  sh ./gradlew uiCheck --console=plain || { echo "uiCheck failed — commit blocked."; exit 1; }
fi
